{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/lifebit-cgpu/structhomology-nf/main/assets/schema_input.json",
    "title": "structhomology-nf samplesheet",
    "description": "One row per UniProtKB accession.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "accession": {
                "type": "string",
                "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})$",
                "errorMessage": "Column 'accession' must be a canonical UniProtKB accession in upper case, e.g. P60174 or A0A1B0GUU1 (no isoform suffix such as '-2', no entry name such as 'TPIS_HUMAN', no spaces).",
                "meta": ["id"]
            },
            "group": {
                "type": "string",
                "enum": ["query", "control"],
                "default": "query",
                "errorMessage": "Column 'group' is optional; when given it must be 'query' or 'control'.",
                "meta": ["group"]
            }
        },
        "required": ["accession"]
    },
    "uniqueEntries": ["accession"]
}
