/*
 * structhomology-nf: main configuration
 */

manifest {
    name            = 'lifebit-cgpu/structhomology-nf'
    author          = 'structhomology-nf contributors'
    homePage        = 'https://github.com/lifebit-cgpu/structhomology-nf'
    description     = 'Structure (Foldseek) versus sequence (MMseqs2) homology search for AlphaFold DB models of UniProt accessions'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.2'
    version         = '1.0.0'
    license         = 'MIT'
}

plugins {
    id 'nf-schema@2.8.0'
}

params {
    // Input / output
    input                   = null
    outdir                  = null
    publish_dir_mode        = 'copy'

    // AlphaFold DB
    afdb_api_url            = 'https://alphafold.ebi.ac.uk/api/prediction'
    afdb_max_forks          = 3

    // pLDDT gate
    min_mean_plddt          = 70
    min_frac_confident      = 0.5

    // Target database
    foldseek_db_name        = 'PDB'
    foldseek_db             = null
    target_pdb_ids          = null
    db_cache_dir            = null

    // Search (identical limits for both arms)
    search_evalue           = 10
    max_seqs                = 1000
    mmseqs_sensitivity      = 7.5

    // Hit classification and annotation
    sig_evalue              = 0.001
    min_tmscore             = 0.5
    min_aln_len             = 50
    top_n                   = 10
    skip_remote_annotation  = false
    rcsb_graphql_url        = 'https://data.rcsb.org/graphql'
    uniprot_rest_url        = 'https://rest.uniprot.org'

    // Positive controls
    controls                = null
    fail_on_control_failure = true
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        cleanup = false
        process.beforeScript = 'echo $HOSTNAME'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
    }
    test      { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
    cloudos   { includeConfig 'conf/cloudos.config' }
}

env {
    PYTHONNOUSERSITE = '1'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}

validation {
    help {
        enabled = true
    }
}
