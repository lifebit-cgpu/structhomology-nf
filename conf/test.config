/*
 * -profile test
 * Three positive controls (TPI1, myoglobin, LDHA) searched against a small
 * Foldseek database built on the fly from 24 RCSB entries: their known PDB
 * relatives plus unrelated decoys. Runs in a few minutes; the control check
 * must pass.
 *
 *   nextflow run lifebit-cgpu/structhomology-nf -profile test,docker --outdir results_test
 */
params {
    input          = "${projectDir}/assets/samplesheet_test.csv"
    outdir         = 'results_test'
    target_pdb_ids = "${projectDir}/assets/test_target_pdb_ids.txt"
    controls       = "${projectDir}/assets/positive_controls.csv"
}

process {
    resourceLimits = [ cpus: 4, memory: 6.GB, time: 1.h ]
}
