/*
 * Per-process options: publishing, tool arguments (ext.args), caching.
 */
process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'AFDB_FETCH' {
        // The AlphaFold DB file server rate-limits parallel requests (HTTP 429)
        maxForks      = params.afdb_max_forks
        errorStrategy = 'retry'
        maxRetries    = 2
        ext.args      = { "--api ${params.afdb_api_url}" }
        publishDir    = [
            path: { "${params.outdir}/afdb/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLDDT_QC' {
        ext.args   = { "--min-mean-plddt ${params.min_mean_plddt} --min-frac-confident ${params.min_frac_confident}" }
        publishDir = [
            path: { "${params.outdir}/plddt_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FOLDSEEK_DATABASES' {
        // Downloaded once and reused by later runs (storeDir), never copied to outdir
        storeDir   = { "${params.db_cache_dir ?: params.outdir + '/databases'}/foldseek" }
        publishDir = [ path: { "${params.outdir}/database" }, enabled: false ]
    }

    withName: 'FETCH_PDB_TARGETS' {
        publishDir = [
            path: { "${params.outdir}/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('targets_manifest.tsv') ? filename : null }
        ]
    }

    withName: 'FOLDSEEK_CREATEDB' {
        publishDir = [ path: { "${params.outdir}/database" }, enabled: false ]
    }

    withName: 'DB_TO_FASTA' {
        publishDir = [
            path: { "${params.outdir}/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.db_info.json') ? filename : null }
        ]
    }

    withName: 'MMSEQS_CREATEDB' {
        publishDir = [ path: { "${params.outdir}/database" }, enabled: false ]
    }

    withName: 'FOLDSEEK_EASYSEARCH' {
        ext.args = { [
            '--format-mode 4',
            '--format-output query,target,theader,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,prob,alntmscore,qtmscore,ttmscore,lddt,qlen,tlen,qcov,tcov',
            "-e ${params.search_evalue}",
            "--max-seqs ${params.max_seqs}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/foldseek" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_EASYSEARCH' {
        ext.args = { [
            '--format-mode 4',
            '--format-output query,target,theader,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,qlen,tlen,qcov,tcov',
            "-s ${params.mmseqs_sensitivity}",
            "-e ${params.search_evalue}",
            "--max-seqs ${params.max_seqs}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/mmseqs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANNOTATE_HITS' {
        ext.args = { [
            "--top-n ${params.top_n}",
            "--sig-evalue ${params.sig_evalue}",
            "--min-tmscore ${params.min_tmscore}",
            "--min-aln-len ${params.min_aln_len}",
            "--rcsb-url ${params.rcsb_graphql_url}",
            "--uniprot-url ${params.uniprot_rest_url}",
            params.skip_remote_annotation ? '--skip-remote' : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/per_protein" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SUMMARISE' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECK_CONTROLS' {
        ext.args = { [
            "--sig-evalue ${params.sig_evalue}",
            "--min-tmscore ${params.min_tmscore}",
            params.fail_on_control_failure ? '--fail-on-failure' : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/controls" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SOFTWARE_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }
}
