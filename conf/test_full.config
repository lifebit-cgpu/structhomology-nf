/*
 * -profile test_full
 * The full analysis: 20 reviewed uncharacterized human proteins plus 3
 * positive controls, searched against Foldseek's PDB database (PDB100).
 * Downloads about 2.3 GB once (4.3 GB unpacked) into --db_cache_dir.
 *
 *   nextflow run lifebit-cgpu/structhomology-nf -profile test_full,docker --outdir results_full
 */
params {
    input            = "${projectDir}/assets/samplesheet_full.csv"
    outdir           = 'results_full'
    foldseek_db_name = 'PDB'
    controls         = "${projectDir}/assets/positive_controls.csv"
}
