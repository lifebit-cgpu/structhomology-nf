/*
 * -profile cloudos
 * Defaults for Lifebit CloudOS. The platform sets the executor (AWS Batch /
 * Azure Batch) and the work directory; this profile enables Docker and adds
 * retries for transient cloud and network failures.
 *
 * Tip: set --db_cache_dir to a persistent bucket path so the Foldseek
 * database is downloaded only once across runs.
 */
docker.enabled = true

process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
}
